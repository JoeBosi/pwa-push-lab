# Copia in .env e riempi con le chiavi vere:  node strumenti/genera-vapid.js
#
# .env NON va versionato: la chiave privata permette di spedire notifiche a nome
# di questo sito su tutti i dispositivi iscritti.

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Identifica chi gestisce il servizio verso i server push (Google, Apple).
# Deve essere un mailto: o un https: veri.
VAPID_SUBJECT=mailto:tu@tuodominio.it

# Se valorizzato, l'invio delle notifiche richiede questo token.
# Lasciato vuoto l'invio e' aperto: comodo in locale, da evitare in produzione.
TOKEN_INVIO=

# Firma i cookie di sessione del sito notizie (almeno 32 caratteri casuali).
# Chi lo conosce puo' fabbricarsi il cookie di qualunque utente.
#   openssl rand -base64 48
SESSIONE_SEGRETO=

HOST=127.0.0.1
PORT=3020
